+    std::fs::copy(main_manifest(body_swapped + 1), main_manifest(body_swapped)).unwrap();
+    assert_eq!(outcome(&plan(keep.clone()).await.unwrap()), before);
+    let error = plan(aged.clone()).await.unwrap_err();
