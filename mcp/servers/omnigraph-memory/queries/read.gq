// Agent Memory — read queries
//
// Search dispatch strategy:
//   The MCP server selects the query name based on which optional filters
//   the caller provided. This avoids relying on undefined behavior for
//   null param filtering in match bindings.

// ── Search (BM25 on content) ─────────────────────────────────────

query search_all($query: String) {
    match {
        $m: Memory
        search($m.content, $query)
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.createdAt,
        bm25($m.content, $query) as score
    }
    order { bm25($m.content, $query) desc }
    limit 20
}

query search_by_repo($query: String, $repo: String) {
    match {
        $m: Memory { repo: $repo }
        search($m.content, $query)
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.createdAt,
        bm25($m.content, $query) as score
    }
    order { bm25($m.content, $query) desc }
    limit 20
}

query search_by_kind($query: String, $kind: String) {
    match {
        $m: Memory { kind: $kind }
        search($m.content, $query)
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.createdAt,
        bm25($m.content, $query) as score
    }
    order { bm25($m.content, $query) desc }
    limit 20
}

query search_by_repo_and_kind($query: String, $repo: String, $kind: String) {
    match {
        $m: Memory { repo: $repo, kind: $kind }
        search($m.content, $query)
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.createdAt,
        bm25($m.content, $query) as score
    }
    order { bm25($m.content, $query) desc }
    limit 20
}

// ── Single node fetch ─────────────────────────────────────────────

query get_memory($slug: String) {
    match {
        $m: Memory { slug: $slug }
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.createdAt, $m.updatedAt
    }
}

// ── Project facts ─────────────────────────────────────────────────

query get_project_facts($repo: String) {
    match {
        $m: Memory { kind: "project_fact", repo: $repo }
    }
    return {
        $m.slug, $m.title, $m.content,
        $m.category, $m.author, $m.tags, $m.createdAt
    }
    order { $m.category, $m.createdAt desc }
}

// ── Patterns ──────────────────────────────────────────────────────

query patterns_all() {
    match {
        $m: Memory { kind: "pattern" }
    }
    return {
        $m.slug, $m.title, $m.content,
        $m.repo, $m.language, $m.author, $m.tags, $m.createdAt
    }
    order { $m.createdAt desc }
    limit 50
}

query patterns_by_repo($repo: String) {
    match {
        $m: Memory { kind: "pattern", repo: $repo }
    }
    return {
        $m.slug, $m.title, $m.content,
        $m.repo, $m.language, $m.author, $m.tags, $m.createdAt
    }
    order { $m.createdAt desc }
}

// ── Workflow Projects ─────────────────────────────────────────────

query get_workflow_project($slug: String) {
    match {
        $p: WorkflowProject { slug: $slug }
    }
    return {
        $p.slug, $p.title, $p.description, $p.repo,
        $p.status, $p.phase, $p.author, $p.tags,
        $p.githubIssue, $p.githubPR,
        $p.createdAt, $p.updatedAt, $p.completedAt
    }
}

query list_projects_by_repo_status($repo: String, $status: String) {
    match {
        $p: WorkflowProject { repo: $repo, status: $status }
    }
    return {
        $p.slug, $p.title, $p.phase, $p.status,
        $p.updatedAt, $p.githubIssue, $p.tags
    }
    order { $p.updatedAt desc }
}

query list_projects_by_repo($repo: String) {
    match {
        $p: WorkflowProject { repo: $repo }
    }
    return {
        $p.slug, $p.title, $p.phase, $p.status,
        $p.updatedAt, $p.githubIssue, $p.tags
    }
    order { $p.updatedAt desc }
}

query list_projects_by_status($status: String) {
    match {
        $p: WorkflowProject { status: $status }
    }
    return {
        $p.slug, $p.title, $p.repo, $p.phase,
        $p.status, $p.updatedAt
    }
    order { $p.updatedAt desc }
    limit 20
}

query list_all_projects() {
    match {
        $p: WorkflowProject
    }
    return {
        $p.slug, $p.title, $p.repo, $p.phase,
        $p.status, $p.updatedAt
    }
    order { $p.updatedAt desc }
    limit 20
}

// ── Workflow Sessions ─────────────────────────────────────────────

query get_workflow_session($slug: String) {
    match {
        $s: WorkflowSession { slug: $slug }
    }
    return {
        $s.slug, $s.projectSlug, $s.sessionId, $s.repo,
        $s.phase, $s.summary, $s.toolsUsed, $s.filesChanged,
        $s.author, $s.tags, $s.startedAt, $s.endedAt
    }
}

query get_session_by_session_id($sessionId: String) {
    match {
        $s: WorkflowSession { sessionId: $sessionId }
    }
    return {
        $s.slug, $s.projectSlug, $s.phase, $s.startedAt
    }
}

query list_sessions_by_project($projectSlug: String) {
    match {
        $s: WorkflowSession { projectSlug: $projectSlug }
    }
    return {
        $s.slug, $s.sessionId, $s.phase, $s.summary,
        $s.toolsUsed, $s.filesChanged,
        $s.startedAt, $s.endedAt
    }
    order { $s.startedAt asc }
}

// ── Workflow Traces (corpus) ──────────────────────────────────────

query get_trace($slug: String) {
    match {
        $t: WorkflowTrace { slug: $slug }
    }
    return {
        $t.slug, $t.projectSlug, $t.title, $t.description,
        $t.repo, $t.phases, $t.sessionCount, $t.duration,
        $t.outcome, $t.lessonsSlug, $t.patternsSlug,
        $t.author, $t.createdAt, $t.tags
    }
}

query list_traces_by_repo($repo: String) {
    match {
        $t: WorkflowTrace { repo: $repo }
    }
    return {
        $t.slug, $t.projectSlug, $t.title, $t.repo,
        $t.phases, $t.sessionCount, $t.duration,
        $t.outcome, $t.createdAt
    }
    order { $t.createdAt desc }
    limit 50
}

query list_all_traces() {
    match {
        $t: WorkflowTrace
    }
    return {
        $t.slug, $t.projectSlug, $t.title, $t.repo,
        $t.phases, $t.sessionCount, $t.duration,
        $t.outcome, $t.createdAt
    }
    order { $t.createdAt desc }
    limit 50
}
