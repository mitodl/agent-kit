{
	"name": "witan-ui",
	"version": "0.0.0",
	"private": true,
	"description": "Web UI for the witan graph. Built into ../witan/ui_dist and shipped inside the witan wheel.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src vite.config.ts vitest.config.ts",
		"format": "biome check --write src vite.config.ts vitest.config.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@modelcontextprotocol/client": "^2.0.0",
		"lit-html": "^3.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"jsdom": "^28.0.0",
		"typescript": "^5.9.3",
		"vite": "^7.1.14",
		"vitest": "^4.0.6"
	}
}
