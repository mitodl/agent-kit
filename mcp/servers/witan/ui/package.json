{
	"name": "witan-ui",
	"version": "0.0.0",
	"private": true,
	"description": "Web UI for the witan graph. Built into ../witan/ui_dist and shipped inside the witan wheel.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && node build-widgets.js",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src build-widgets.js vite.config.ts vitest.config.ts",
		"format": "biome check --write src build-widgets.js vite.config.ts vitest.config.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@fontsource/alegreya": "^5.3.0",
		"@fontsource/alegreya-sans": "^5.3.0",
		"@modelcontextprotocol/client": "^2.0.0",
		"@modelcontextprotocol/ext-apps": "^2.0.0",
		"lit-html": "^3.3.1",
		"oidc-spa": "^10.2.15",
		"vis-data": "^8.0.5",
		"vis-network": "^10.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"jsdom": "28.1.0",
		"typescript": "5.9.3",
		"vite": "7.3.6",
		"vite-plugin-singlefile": "2.3.3",
		"vitest": "4.1.11"
	}
}
