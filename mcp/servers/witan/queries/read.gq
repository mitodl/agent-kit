// Agent Memory — read queries
//
// Search dispatch strategy:
//   The MCP server selects the query name based on which optional filters
//   the caller provided. This avoids relying on undefined behavior for
//   null param filtering in match bindings.

// ── Search (BM25 on content) ─────────────────────────────────────

query search_all($query: String) {
    match {
        $m: Memory
        search($m.content, $query)
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.created_at, $m.updated_at, $m.confidence
    }
    order { bm25($m.content, $query) desc }
    limit 20
}

query search_by_repo($query: String, $repo: String) {
    match {
        $m: Memory { repo: $repo }
        search($m.content, $query)
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.created_at, $m.updated_at, $m.confidence
    }
    order { bm25($m.content, $query) desc }
    limit 20
}

query search_by_kind($query: String, $kind: String) {
    match {
        $m: Memory { kind: $kind }
        search($m.content, $query)
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.created_at, $m.updated_at, $m.confidence
    }
    order { bm25($m.content, $query) desc }
    limit 20
}

query search_by_repo_and_kind($query: String, $repo: String, $kind: String) {
    match {
        $m: Memory { repo: $repo, kind: $kind }
        search($m.content, $query)
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.created_at, $m.updated_at, $m.confidence
    }
    order { bm25($m.content, $query) desc }
    limit 20
}

// ── Listing (no search; filtered by repo and/or kind) ─────────────

query list_memories() {
    match {
        $m: Memory
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.created_at, $m.updated_at, $m.confidence
    }
    order { $m.created_at desc }
    limit 100
}

query list_memories_by_repo($repo: String) {
    match {
        $m: Memory { repo: $repo }
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.created_at, $m.updated_at, $m.confidence
    }
    order { $m.created_at desc }
    limit 100
}

query list_memories_by_kind($kind: String) {
    match {
        $m: Memory { kind: $kind }
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.created_at, $m.updated_at, $m.confidence
    }
    order { $m.created_at desc }
    limit 100
}

query list_memories_by_repo_kind($repo: String, $kind: String) {
    match {
        $m: Memory { repo: $repo, kind: $kind }
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.created_at, $m.updated_at, $m.confidence
    }
    order { $m.created_at desc }
    limit 100
}

// High-limit variants for the unscoped fallback path: the normal list_memories
// cap (100) is applied before Python filtering by repo=null, so unscoped
// memories can be pushed out when many repo-scoped ones are newer.

query list_memories_unbounded() {
    match {
        $m: Memory
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.created_at, $m.updated_at, $m.confidence
    }
    order { $m.created_at desc }
    limit 10000
}

query list_memories_by_kind_unbounded($kind: String) {
    match {
        $m: Memory { kind: $kind }
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.created_at, $m.updated_at, $m.confidence
    }
    order { $m.created_at desc }
    limit 10000
}

// ── Single node fetch ─────────────────────────────────────────────

query get_memory($slug: String) {
    match {
        $m: Memory { slug: $slug }
    }
    return {
        $m.slug, $m.kind, $m.title, $m.content,
        $m.repo, $m.language, $m.category, $m.severity,
        $m.author, $m.tags, $m.symbol_refs,
        $m.confidence, $m.created_at, $m.updated_at
    }
}

// ── Inter-memory edge traversal ───────────────────────────────────
// Both endpoints are bound as typed Memory nodes (the engine requires the far
// side of a traversal to be a bound node, see code_read.gq). Directional edges
// expose one query; symmetric edges (contradicts, related_to) expose an out- and
// an in-direction query that the server unions.

query supersedes_targets($slug: String) {
    match {
        $m: Memory { slug: $slug }
        $other: Memory
        $m supersedes $other
    }
    return { $other.slug, $other.kind, $other.title, $other.repo, $other.created_at }
}

query refines_targets($slug: String) {
    match {
        $m: Memory { slug: $slug }
        $other: Memory
        $m refines $other
    }
    return { $other.slug, $other.kind, $other.title, $other.repo, $other.created_at }
}

query applies_to_targets($slug: String) {
    match {
        $m: Memory { slug: $slug }
        $other: Memory
        $m appliesto $other
    }
    return { $other.slug, $other.kind, $other.title, $other.repo, $other.created_at }
}

query related_out($slug: String) {
    match {
        $m: Memory { slug: $slug }
        $other: Memory
        $m relatedto $other
    }
    return { $other.slug, $other.kind, $other.title, $other.repo, $other.created_at }
}

query related_in($slug: String) {
    match {
        $m: Memory { slug: $slug }
        $other: Memory
        $other relatedto $m
    }
    return { $other.slug, $other.kind, $other.title, $other.repo, $other.created_at }
}

query contradicts_out($slug: String) {
    match {
        $m: Memory { slug: $slug }
        $other: Memory
        $m contradicts $other
    }
    return { $other.slug, $other.kind, $other.title, $other.repo, $other.created_at }
}

query contradicts_in($slug: String) {
    match {
        $m: Memory { slug: $slug }
        $other: Memory
        $other contradicts $m
    }
    return { $other.slug, $other.kind, $other.title, $other.repo, $other.created_at }
}

// Memories that AppliesTo $slug (in-direction; pairs with applies_to_targets).
query applies_to_sources($slug: String) {
    match {
        $other: Memory
        $m: Memory { slug: $slug }
        $other appliesto $m
    }
    return { $other.slug, $other.kind, $other.title, $other.repo, $other.created_at }
}

// Sessions that produced $slug (for provenance-sibling expansion in recall).
query producing_sessions($slug: String) {
    match {
        $s: WorkflowSession
        $m: Memory { slug: $slug }
        $s sessionproduced $m
    }
    return { $s.slug }
}

// Memories a task Addresses (recall task-seed).
query addressed_memories($task_slug: String) {
    match {
        $t: Task { slug: $task_slug }
        $m: Memory
        $t addresses $m
    }
    return { $m.slug, $m.kind, $m.title, $m.repo, $m.created_at }
}

// Recall expansion: all memories sharing any Topic with $slug, in one query
// (memory → topic → memory) instead of a per-topic fan-out. Includes $slug; the
// server discards self.
query topic_siblings($slug: String) {
    match {
        $m: Memory { slug: $slug }
        $tp: Topic
        $m tagged $tp
        $other: Memory
        $other tagged $tp
    }
    return { $other.slug }
}

// Recall expansion: all memories produced by any session that produced $slug, in
// one query (memory → session → memory). Includes $slug; the server discards self.
query provenance_siblings($slug: String) {
    match {
        $m: Memory { slug: $slug }
        $s: WorkflowSession
        $s sessionproduced $m
        $other: Memory
        $s sessionproduced $other
    }
    return { $other.slug }
}

// All slugs that are the TARGET of any Supersedes edge — i.e. the superseded set.
// Used to prune/deprioritise in the Python re-rank. Bounded; the superseded set
// is small relative to total memories.
query all_superseded_slugs() {
    match {
        $m: Memory
        $old: Memory
        $m supersedes $old
    }
    return { $old.slug }
}

// ── Edge index (for the composite re-rank) ────────────────────────
// Each query returns one endpoint slug per edge (single column — the row
// unwrapper collapses "a.slug"/"b.slug" to "slug", so returning both would
// collide). The server tallies degrees in Python to score corroboration and
// flag contradicted memories. Symmetric edges expose both endpoints.

query rel_edges_from() {
    match { $a: Memory $b: Memory $a relatedto $b }
    return { $a.slug }
}
query rel_edges_to() {
    match { $a: Memory $b: Memory $a relatedto $b }
    return { $b.slug }
}
query applies_edges_from() {
    match { $a: Memory $b: Memory $a appliesto $b }
    return { $a.slug }
}
query applies_edges_to() {
    match { $a: Memory $b: Memory $a appliesto $b }
    return { $b.slug }
}
query refines_edges_from() {
    match { $a: Memory $b: Memory $a refines $b }
    return { $a.slug }
}
query refines_edges_to() {
    match { $a: Memory $b: Memory $a refines $b }
    return { $b.slug }
}
query contradicts_edges_from() {
    match { $a: Memory $b: Memory $a contradicts $b }
    return { $a.slug }
}
query contradicts_edges_to() {
    match { $a: Memory $b: Memory $a contradicts $b }
    return { $b.slug }
}
query informed_edges_to() {
    match { $p: WorkflowProject $m: Memory $p informed $m }
    return { $m.slug }
}
query produced_edges_to() {
    match { $s: WorkflowSession $m: Memory $s sessionproduced $m }
    return { $m.slug }
}

// ── Topics ────────────────────────────────────────────────────────

// Slim projection for the topic backfill — slug + tags only, no content.
query list_memory_tags() {
    match { $m: Memory }
    return { $m.slug, $m.tags }
    limit 10000
}

query get_topic($slug: String) {
    match { $tp: Topic { slug: $slug } }
    return { $tp.slug, $tp.name, $tp.kind, $tp.created_at }
}

query topic_by_name_kind($name: String, $kind: String) {
    match { $tp: Topic { name: $name, kind: $kind } }
    return { $tp.slug, $tp.name, $tp.kind }
}

// Memories attached to a topic (traversal-based retrieval; cross-repo by nature).
query memories_for_topic($topic_slug: String) {
    match {
        $tp: Topic { slug: $topic_slug }
        $m: Memory
        $m tagged $tp
    }
    return { $m.slug, $m.kind, $m.title, $m.repo, $m.created_at }
}

// Topics a memory is tagged with (for expand + display).
query topics_for_memory($slug: String) {
    match {
        $m: Memory { slug: $slug }
        $tp: Topic
        $m tagged $tp
    }
    return { $tp.slug, $tp.name, $tp.kind }
}

// ── Project facts ─────────────────────────────────────────────────

query get_project_facts($repo: String) {
    match {
        $m: Memory { kind: "project_fact", repo: $repo }
    }
    return {
        $m.slug, $m.title, $m.content, $m.repo,
        $m.category, $m.author, $m.tags, $m.created_at
    }
    order { $m.category, $m.created_at desc }
}

query project_facts_all() {
    match {
        $m: Memory { kind: "project_fact" }
    }
    return {
        $m.slug, $m.title, $m.content, $m.repo,
        $m.category, $m.author, $m.tags, $m.created_at
    }
    order { $m.created_at desc }
}

// ── Patterns ──────────────────────────────────────────────────────

query patterns_all() {
    match {
        $m: Memory { kind: "pattern" }
    }
    return {
        $m.slug, $m.title, $m.content,
        $m.repo, $m.language, $m.author, $m.tags, $m.created_at
    }
    order { $m.created_at desc }
    limit 50
}

query patterns_by_repo($repo: String) {
    match {
        $m: Memory { kind: "pattern", repo: $repo }
    }
    return {
        $m.slug, $m.title, $m.content,
        $m.repo, $m.language, $m.author, $m.tags, $m.created_at
    }
    order { $m.created_at desc }
}

// ── Workflow Projects ─────────────────────────────────────────────

query get_workflow_project($slug: String) {
    match {
        $p: WorkflowProject { slug: $slug }
    }
    return {
        $p.slug, $p.title, $p.description, $p.repos,
        $p.status, $p.phase, $p.author, $p.tags,
        $p.github_issue, $p.github_pr,
        $p.created_at, $p.updated_at, $p.completed_at,
        $p.blocked_by
    }
}

// Repo membership can't be expressed as a match-shorthand on the `repos` list,
// so callers fetch by status (or all) and Python-filter on list membership.

query list_projects_by_status($status: String) {
    match {
        $p: WorkflowProject { status: $status }
    }
    return {
        $p.slug, $p.title, $p.repos, $p.phase,
        $p.status, $p.updated_at, $p.github_issue, $p.tags,
        $p.blocked_by
    }
    order { $p.updated_at desc }
    // Unbounded: repo membership is filtered in Python (repos is a list), so the
    // full active set must be fetched before filtering — a small cap would drop a
    // repo's projects when many projects exist across repos. Callers slice for display.
    limit 1000000
}

query list_all_projects() {
    match {
        $p: WorkflowProject
    }
    return {
        $p.slug, $p.title, $p.repos, $p.phase,
        $p.status, $p.updated_at, $p.github_issue, $p.tags,
        $p.blocked_by
    }
    order { $p.updated_at desc }
    // Unbounded: repo membership is filtered in Python (repos is a list), so the
    // full active set must be fetched before filtering — a small cap would drop a
    // repo's projects when many projects exist across repos. Callers slice for display.
    limit 1000000
}

// get_project_blockers: returns all WorkflowProject nodes whose slug appears in
// the blocked_by list of the project identified by $slug.
// Since blocked_by is a list and list membership isn't a graph match-filter,
// the server fetches the target project's blocked_by list then resolves each
// blocker slug individually in Python (see workflow_project_get_blockers).
// This query is the single-slug resolver used in that loop.
query get_workflow_project_by_slug($slug: String) {
    match {
        $p: WorkflowProject { slug: $slug }
    }
    return {
        $p.slug, $p.title, $p.status, $p.phase,
        $p.repos, $p.updated_at, $p.blocked_by
    }
}

// ── Workflow Sessions ─────────────────────────────────────────────

query list_sessions_by_project($project_slug: String) {
    match {
        $s: WorkflowSession { project_slug: $project_slug }
    }
    return {
        $s.slug, $s.session_id, $s.phase, $s.summary,
        $s.tools_used, $s.files_changed,
        $s.started_at, $s.ended_at
    }
    order { $s.started_at asc }
}

// Memories produced during a session (provenance walk). Edge predicate is the
// type name lowercased with underscores stripped: `sessionproduced`.
query session_produced_memories($session_slug: String) {
    match {
        $s: WorkflowSession { slug: $session_slug }
        $m: Memory
        $s sessionproduced $m
    }
    return { $m.slug, $m.kind, $m.title, $m.created_at }
    order { $m.created_at asc }
}

// All memories produced by any session of a project, in one query — the default
// (flat) path for project_memories, avoiding a per-session N+1. Sessions carry a
// denormalized project_slug, so this needs no project→session traversal.
query project_produced_memories($project_slug: String) {
    match {
        $s: WorkflowSession { project_slug: $project_slug }
        $m: Memory
        $s sessionproduced $m
    }
    return { $m.slug, $m.kind, $m.title, $m.created_at }
    order { $m.created_at asc }
}

// Memories a project Informed (project-grain provenance).
query informed_memories($project_slug: String) {
    match {
        $p: WorkflowProject { slug: $project_slug }
        $m: Memory
        $p informed $m
    }
    return { $m.slug, $m.kind, $m.title, $m.created_at }
    order { $m.created_at asc }
}

// ── Workflow Traces (corpus) ──────────────────────────────────────

query get_trace($slug: String) {
    match {
        $t: WorkflowTrace { slug: $slug }
    }
    return {
        $t.slug, $t.project_slug, $t.title, $t.description,
        $t.repos, $t.phases, $t.session_count, $t.duration,
        $t.outcome, $t.lessons_slug, $t.patterns_slug,
        $t.author, $t.created_at, $t.tags
    }
}

// Repo/tag membership can't be expressed as a match-shorthand on list fields,
// so callers fetch every trace and Python-filter — same pattern as
// list_all_projects.
query list_all_traces() {
    match {
        $t: WorkflowTrace
    }
    return {
        $t.slug, $t.project_slug, $t.title, $t.description,
        $t.repos, $t.phases, $t.session_count, $t.duration,
        $t.outcome, $t.lessons_slug, $t.patterns_slug,
        $t.author, $t.created_at, $t.tags
    }
    order { $t.created_at desc }
    limit 1000000
}

// ── Tasks ─────────────────────────────────────────────────────────

query get_task($slug: String) {
    match {
        $t: Task { slug: $slug }
    }
    return {
        $t.slug, $t.title, $t.description, $t.repo,
        $t.type, $t.status, $t.priority,
        $t.project_slug, $t.parent_slug, $t.blocked_by,
        $t.assignee, $t.external_uri, $t.resolution,
        $t.symbol_refs, $t.tags, $t.author,
        $t.created_at, $t.updated_at, $t.closed_at, $t.claimed_at
    }
}

query list_tasks_by_repo($repo: String) {
    match {
        $t: Task { repo: $repo }
    }
    return {
        $t.slug, $t.title, $t.repo, $t.type, $t.status, $t.priority,
        $t.project_slug, $t.parent_slug, $t.blocked_by,
        $t.assignee, $t.external_uri, $t.tags, $t.updated_at, $t.claimed_at
    }
    order { $t.updated_at desc }
}

query list_tasks_by_repo_status($repo: String, $status: String) {
    match {
        $t: Task { repo: $repo, status: $status }
    }
    return {
        $t.slug, $t.title, $t.repo, $t.type, $t.status, $t.priority,
        $t.project_slug, $t.parent_slug, $t.blocked_by,
        $t.assignee, $t.external_uri, $t.tags, $t.updated_at, $t.claimed_at
    }
    order { $t.updated_at desc }
}

query list_tasks_by_status($status: String) {
    match {
        $t: Task { status: $status }
    }
    return {
        $t.slug, $t.title, $t.repo, $t.type, $t.status, $t.priority,
        $t.project_slug, $t.parent_slug, $t.blocked_by,
        $t.assignee, $t.external_uri, $t.tags, $t.updated_at, $t.claimed_at
    }
    order { $t.updated_at desc }
    limit 50
}

query list_all_tasks() {
    match {
        $t: Task
    }
    return {
        $t.slug, $t.title, $t.repo, $t.type, $t.status, $t.priority,
        $t.project_slug, $t.parent_slug, $t.blocked_by,
        $t.assignee, $t.external_uri, $t.tags, $t.updated_at, $t.claimed_at
    }
    order { $t.updated_at desc }
    limit 50
}

query list_unscoped_tasks() {
    match {
        $t: Task
    }
    return {
        $t.slug, $t.title, $t.repo, $t.type, $t.status, $t.priority,
        $t.project_slug, $t.parent_slug, $t.blocked_by,
        $t.assignee, $t.external_uri, $t.tags, $t.updated_at, $t.claimed_at
    }
    order { $t.updated_at desc }
    limit 10000
}

query list_tasks_by_project($project_slug: String) {
    match {
        $t: Task { project_slug: $project_slug }
    }
    return {
        $t.slug, $t.title, $t.repo, $t.type, $t.status, $t.priority,
        $t.project_slug, $t.parent_slug, $t.blocked_by,
        $t.assignee, $t.external_uri, $t.tags, $t.updated_at, $t.claimed_at
    }
    order { $t.updated_at desc }
}

query list_tasks_by_parent($parent_slug: String) {
    match {
        $t: Task { parent_slug: $parent_slug }
    }
    return {
        $t.slug, $t.title, $t.repo, $t.type, $t.status, $t.priority,
        $t.project_slug, $t.parent_slug, $t.blocked_by,
        $t.assignee, $t.external_uri, $t.tags, $t.updated_at, $t.claimed_at
    }
    order { $t.priority, $t.updated_at desc }
}

// ── Reverse symbol references (Layer 1 ← Layer 2 composition) ──────
// Return nodes carrying symbol_refs so the server can filter for a specific
// code-graph symbol id in Python (list-membership, scoped by repo).

query memories_by_repo($repo: String) {
    match {
        $m: Memory { repo: $repo }
    }
    return { $m.slug, $m.kind, $m.title, $m.repo, $m.symbol_refs }
}

query tasks_by_repo_refs($repo: String) {
    match {
        $t: Task { repo: $repo }
    }
    return { $t.slug, $t.title, $t.type, $t.status, $t.repo, $t.symbol_refs }
}

query memories_with_refs() {
    match {
        $m: Memory
    }
    return { $m.slug, $m.kind, $m.title, $m.repo, $m.symbol_refs }
    limit 200
}

query tasks_with_refs() {
    match {
        $t: Task
    }
    return { $t.slug, $t.title, $t.type, $t.status, $t.repo, $t.symbol_refs }
    limit 200
}

// ── Code Branches ───────────────────────────────────────────────────

query get_code_branch($slug: String) {
    match {
        $b: CodeBranch { slug: $slug }
    }
    return { $b.slug, $b.repo, $b.branch, $b.status, $b.created_at, $b.updated_at }
}

query code_branches_by_repo($repo: String) {
    match {
        $b: CodeBranch { repo: $repo }
    }
    return { $b.slug, $b.repo, $b.branch, $b.status, $b.created_at, $b.updated_at }
}

// Tasks a branch WorksOn — "which task(s) does branch B carry".
query code_branch_tasks($branch_slug: String) {
    match {
        $b: CodeBranch { slug: $branch_slug }
        $t: Task
        $b workson $t
    }
    return {
        $t.slug, $t.title, $t.status, $t.priority, $t.assignee, $t.claimed_at
    }
}

// The branch(es) carrying a task — "which branch carries task X".
query task_code_branches($task_slug: String) {
    match {
        $t: Task { slug: $task_slug }
        $b: CodeBranch
        $b workson $t
    }
    return { $b.slug, $b.repo, $b.branch, $b.status, $b.updated_at }
}

// Existence checks so repeated workflow_session_start/task_claim calls for
// the same branch don't pile up duplicate edges.
query code_branch_works_on_edge($branch_slug: String, $task_slug: String) {
    match {
        $b: CodeBranch { slug: $branch_slug }
        $t: Task { slug: $task_slug }
        $b workson $t
    }
    return { $b.slug }
}

query code_branch_for_project_edge($branch_slug: String, $project_slug: String) {
    match {
        $b: CodeBranch { slug: $branch_slug }
        $p: WorkflowProject { slug: $project_slug }
        $b forproject $p
    }
    return { $b.slug }
}
