// ── Code Branch mutations ──────────────────────────────────────────

query insert_code_branch(
    $slug: String,
    $repo: String,
    $branch: String,
    $status: String,
    $created_at: DateTime,
    $updated_at: DateTime
) {
    insert CodeBranch {
        slug: $slug,
        repo: $repo,
        branch: $branch,
        status: $status,
        created_at: $created_at,
        updated_at: $updated_at
    }
}

query touch_code_branch($slug: String, $status: String, $updated_at: DateTime) {
    update CodeBranch
        set { status: $status, updated_at: $updated_at }
        where slug = $slug
}

