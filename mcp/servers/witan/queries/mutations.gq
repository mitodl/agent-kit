// Agent Memory — mutation queries

// ── Insert ────────────────────────────────────────────────────────

query insert_memory(
    $slug: String,
    $kind: String,
    $title: String,
    $content: String,
    $repo: String?,
    $language: String?,
    $category: String?,
    $severity: String?,
    $author: String,
    $tags: [String]?,
    $symbol_refs: [String]?,
    $confidence: F32?,
    $created_at: DateTime,
    $updated_at: DateTime
) {
    insert Memory {
        slug: $slug,
        kind: $kind,
        title: $title,
        content: $content,
        repo: $repo,
        language: $language,
        category: $category,
        severity: $severity,
        author: $author,
        tags: $tags,
        symbol_refs: $symbol_refs,
        confidence: $confidence,
        created_at: $created_at,
        updated_at: $updated_at
    }
}

// ── Update ────────────────────────────────────────────────────────
// Updates ALL mutable fields. The MCP server reads the current node first,
// merges caller-supplied changes, then calls this query with the full set.
// This avoids needing per-field update queries.

query update_memory(
    $slug: String,
    $title: String,
    $content: String,
    $repo: String?,
    $language: String?,
    $category: String?,
    $severity: String?,
    $tags: [String]?,
    $symbol_refs: [String]?,
    $confidence: F32?,
    $updated_at: DateTime
) {
    update Memory
        set {
            title: $title,
            content: $content,
            repo: $repo,
            language: $language,
            category: $category,
            severity: $severity,
            tags: $tags,
            symbol_refs: $symbol_refs,
            confidence: $confidence,
            updated_at: $updated_at
        }
        where slug = $slug
}

// ── Edges ─────────────────────────────────────────────────────────

query link_supersedes($from: String, $to: String) {
    insert Supersedes { from: $from, to: $to }
}

query link_applies_to($from: String, $to: String) {
    insert AppliesTo { from: $from, to: $to }
}

query link_refines($from: String, $to: String) {
    insert Refines { from: $from, to: $to }
}

query link_contradicts($from: String, $to: String) {
    insert Contradicts { from: $from, to: $to }
}

query link_related_to($from: String, $to: String) {
    insert RelatedTo { from: $from, to: $to }
}

// ── Topics ────────────────────────────────────────────────────────

query insert_topic(
    $slug: String, $name: String, $kind: String, $created_at: DateTime
) {
    insert Topic { slug: $slug, name: $name, kind: $kind, created_at: $created_at }
}

query link_tagged($from: String, $to: String) {
    insert Tagged { from: $from, to: $to }
}

// ── Workflow Project mutations ─────────────────────────────────────

query insert_workflow_project(
    $slug: String,
    $title: String,
    $description: String,
    $repos: [String]?,
    $status: String,
    $phase: String,
    $author: String,
    $tags: [String]?,
    $github_issue: String?,
    $github_pr: String?,
    $created_at: DateTime,
    $updated_at: DateTime
) {
    insert WorkflowProject {
        slug: $slug,
        title: $title,
        description: $description,
        repos: $repos,
        status: $status,
        phase: $phase,
        author: $author,
        tags: $tags,
        github_issue: $github_issue,
        github_pr: $github_pr,
        created_at: $created_at,
        updated_at: $updated_at
    }
}

query update_workflow_project_repos(
    $slug: String,
    $repos: [String]?,
    $updated_at: DateTime
) {
    update WorkflowProject
        set { repos: $repos, updated_at: $updated_at }
        where slug = $slug
}

query update_workflow_project_description(
    $slug: String,
    $description: String,
    $updated_at: DateTime
) {
    update WorkflowProject
        set { description: $description, updated_at: $updated_at }
        where slug = $slug
}

// The `workflow_project_update` write. Every editable field in one set, since
// the caller supplies only what changed and the tool reads-modifies-writes the
// rest — a per-field mutation would need a read between each one. `phase`,
// `github_pr`, `completed_at` and `blocked_by` are deliberately absent: they
// belong to advance/complete/block, which enforce their own semantics.
query update_workflow_project_fields(
    $slug: String,
    $title: String,
    $description: String,
    $repos: [String]?,
    $status: String,
    $tags: [String]?,
    $github_issue: String?,
    $updated_at: DateTime
) {
    update WorkflowProject
        set {
            title: $title,
            description: $description,
            repos: $repos,
            status: $status,
            tags: $tags,
            github_issue: $github_issue,
            updated_at: $updated_at
        }
        where slug = $slug
}

query update_workflow_project_phase(
    $slug: String,
    $phase: String,
    $github_pr: String?,
    $updated_at: DateTime
) {
    update WorkflowProject
        set { phase: $phase, github_pr: $github_pr, updated_at: $updated_at }
        where slug = $slug
}

query update_workflow_project_complete(
    $slug: String,
    $status: String,
    $github_pr: String?,
    $completed_at: DateTime,
    $updated_at: DateTime
) {
    update WorkflowProject
        set {
            status: $status,
            github_pr: $github_pr,
            completed_at: $completed_at,
            updated_at: $updated_at
        }
        where slug = $slug
}

query update_workflow_project_blocked_by(
    $slug: String,
    $blocked_by: [String]?,
    $updated_at: DateTime
) {
    update WorkflowProject
        set { blocked_by: $blocked_by, updated_at: $updated_at }
        where slug = $slug
}

// ── Workflow Edge mutations ────────────────────────────────────────

query link_project_blocks($from: String, $to: String) {
    insert ProjectBlocks { from: $from, to: $to }
}

// ── Workflow Session mutations ─────────────────────────────────────

query insert_workflow_session(
    $slug: String,
    $project_slug: String,
    $session_id: String,
    $repo: String?,
    $phase: String,
    $summary: String,
    $author: String,
    $tags: [String]?,
    $started_at: DateTime
) {
    insert WorkflowSession {
        slug: $slug,
        project_slug: $project_slug,
        session_id: $session_id,
        repo: $repo,
        phase: $phase,
        summary: $summary,
        author: $author,
        tags: $tags,
        started_at: $started_at
    }
}

// For the one-shot `witan migrate repo-keys` scan only — no tool exposes
// changing a session's repo otherwise (it's set once at workflow_session_start).
query update_workflow_session_repo($slug: String, $repo: String?) {
    update WorkflowSession
        set { repo: $repo }
        where slug = $slug
}

// The re-entrant `workflow_session_start` path: fold a repeat call's repo/tags
// into the session the first call created, rather than minting a second node.
query update_workflow_session_meta(
    $slug: String,
    $repo: String?,
    $tags: [String]?
) {
    update WorkflowSession
        set { repo: $repo, tags: $tags }
        where slug = $slug
}

// `witan migrate dedupe-sessions`: flag a session a retry minted, pointing at
// the one that survives. The row is kept, only excluded from aggregates.
query update_workflow_session_superseded(
    $slug: String,
    $superseded_by: String?
) {
    update WorkflowSession
        set { superseded_by: $superseded_by }
        where slug = $slug
}

query update_workflow_session_end(
    $slug: String,
    $summary: String,
    $tools_used: [String]?,
    $files_changed: [String]?,
    $ended_at: DateTime
) {
    update WorkflowSession
        set {
            summary: $summary,
            tools_used: $tools_used,
            files_changed: $files_changed,
            ended_at: $ended_at
        }
        where slug = $slug
}

// ── Workflow Trace mutations ───────────────────────────────────────

query insert_workflow_trace(
    $slug: String,
    $project_slug: String,
    $repos: [String]?,
    $title: String,
    $description: String,
    $session_count: I32,
    $phases: [String],
    $duration: I32?,
    $outcome: String,
    $lessons_slug: [String]?,
    $patterns_slug: [String]?,
    $author: String,
    $tags: [String]?,
    $created_at: DateTime
) {
    insert WorkflowTrace {
        slug: $slug,
        project_slug: $project_slug,
        repos: $repos,
        title: $title,
        description: $description,
        session_count: $session_count,
        phases: $phases,
        duration: $duration,
        outcome: $outcome,
        lessons_slug: $lessons_slug,
        patterns_slug: $patterns_slug,
        author: $author,
        tags: $tags,
        created_at: $created_at
    }
}

// For the one-shot `witan migrate repo-keys` scan only — WorkflowTrace is
// otherwise immutable after creation (see schema.pg); this corrects the case
// of an already-recorded repos list, never its substantive content.
query update_workflow_trace_repos($slug: String, $repos: [String]?) {
    update WorkflowTrace
        set { repos: $repos }
        where slug = $slug
}

query update_workflow_trace_annotations(
    $slug: String,
    $lessons_slug: [String]?,
    $patterns_slug: [String]?
) {
    update WorkflowTrace
        set { lessons_slug: $lessons_slug, patterns_slug: $patterns_slug }
        where slug = $slug
}

// ── Workflow Edge mutations ────────────────────────────────────────

query link_belongs_to($from: String, $to: String) {
    insert BelongsTo { from: $from, to: $to }
}

query link_produced($from: String, $to: String) {
    insert Produced { from: $from, to: $to }
}

query link_informed($from: String, $to: String) {
    insert Informed { from: $from, to: $to }
}

query link_session_produced($from: String, $to: String) {
    insert SessionProduced { from: $from, to: $to }
}

// ── Task mutations ─────────────────────────────────────────────────

query insert_task(
    $slug: String,
    $title: String,
    $description: String,
    $repo: String?,
    $type: String,
    $status: String,
    $priority: String,
    $project_slug: String?,
    $parent_slug: String?,
    $blocked_by: [String]?,
    $assignee: String?,
    $external_uri: String?,
    $author: String,
    $symbol_refs: [String]?,
    $tags: [String]?,
    $created_at: DateTime,
    $updated_at: DateTime,
    $claimed_at: DateTime?
) {
    insert Task {
        slug: $slug,
        title: $title,
        description: $description,
        repo: $repo,
        type: $type,
        status: $status,
        priority: $priority,
        project_slug: $project_slug,
        parent_slug: $parent_slug,
        blocked_by: $blocked_by,
        assignee: $assignee,
        external_uri: $external_uri,
        author: $author,
        symbol_refs: $symbol_refs,
        tags: $tags,
        created_at: $created_at,
        updated_at: $updated_at,
        claimed_at: $claimed_at
    }
}

// Updates ALL mutable fields. The MCP server reads the current node first,
// merges caller-supplied changes, then calls this with the full set.
query update_task(
    $slug: String,
    $title: String,
    $description: String,
    $type: String,
    $status: String,
    $priority: String,
    $repo: String?,
    $project_slug: String?,
    $parent_slug: String?,
    $blocked_by: [String]?,
    $assignee: String?,
    $external_uri: String?,
    $resolution: String?,
    $symbol_refs: [String]?,
    $tags: [String]?,
    $closed_at: DateTime?,
    $updated_at: DateTime,
    $claimed_at: DateTime?
) {
    update Task
        set {
            title: $title,
            description: $description,
            type: $type,
            status: $status,
            priority: $priority,
            repo: $repo,
            project_slug: $project_slug,
            parent_slug: $parent_slug,
            blocked_by: $blocked_by,
            assignee: $assignee,
            external_uri: $external_uri,
            resolution: $resolution,
            symbol_refs: $symbol_refs,
            tags: $tags,
            closed_at: $closed_at,
            updated_at: $updated_at,
            claimed_at: $claimed_at
        }
        where slug = $slug
}

