// Minimal stats over a Layer-2 code-graph store, used by `witan
// repos`. Run against an witan-code store (which has CodeFile nodes),
// not the memory graph. Bundled here so the CLI works as an installed tool
// without needing the codegraph package's query files on disk.

query repo_files() {
    match {
        $f: CodeFile
    }
    return { $f.slug }
    limit 1000000
}
