// Cross-Repo Context Bridge — read / delete / search queries (_bridge.omni).
//
// Linkages are NOT edges: they are computed by grouping InterfaceBinding rows on
// (kind, key_norm) in Python. These queries just filter + search the flat node.
// Read filters use the match-shorthand `{ field: $param }` only (standalone
// `where`/quoted-key parse-errors in reads); deletes use `where`.

// ── Deletes (reindex cleanup) ─────────────────────────────────────
// Per-file purge: drop one source file's bindings so a reindex only replaces
// what it re-extracted (an incremental full-repo index skips unchanged files,
// so a repo-wide purge would orphan their bindings).

query delete_bindings_in_file($repo: String, $file: String) {
    delete InterfaceBinding where repo = $repo and file = $file
}

// The readiness probe (`store.store_health`). The bridge's per-repo sibling
// answers this with code_read.gq's `count_files`, which matches CodeFile — a
// node the bridge schema does not have, so asking it here reports a perfectly
// healthy bridge as unreadable. Counted in the engine, like `count_files`, and
// read positionally for the same reason: the column takes the match variable's
// name on a populated store but "?" on an empty one.

query count_bindings() {
    match {
        $b: InterfaceBinding
    }
    return { count($b) }
}

// All bindings — read once to build the cross-repo dependency visualization.

query all_bindings() {
    match {
        $b: InterfaceBinding
    }
    return {
        $b.kind, $b.sub_kind, $b.key, $b.key_norm, $b.role, $b.repo,
        $b.file, $b.symbol_id, $b.framework, $b.generic, $b.confidence,
        $b.symbol, $b.line
    }
    limit 1000000
}

// ── Per-repo symbol table (Stage 1 — docs/SYMBOL_TABLE.md) ────────
// The table is rebuilt exactly on every bridge write: delete the repo's rows,
// re-aggregate from surviving + fresh bindings. Delete is keyed on the single
// repo field (delete `where` takes one condition).

query delete_repo_symbols($repo: String) {
    delete RepoSymbol where repo = $repo
}

query repo_symbols($repo: String) {
    match {
        $s: RepoSymbol { repo: $repo }
    }
    return {
        $s.slug, $s.repo, $s.role, $s.symbol, $s.scheme, $s.descriptor,
        $s.key_norm, $s.manager, $s.package, $s.version, $s.kind,
        $s.n_refs, $s.confidence, $s.file, $s.line
    }
    order { $s.symbol asc }
    limit 100000
}

// Every RepoSymbol row across all repos — Stage 2 (witan_code.stitch) reads
// this once and joins external/exported rows in Python, the same "bulk read,
// group in Python" pattern all_bindings/build_graph already use for the
// heuristic tier.

query all_repo_symbols() {
    match {
        $s: RepoSymbol
    }
    return {
        $s.repo, $s.role, $s.symbol, $s.scheme, $s.descriptor,
        $s.key_norm, $s.manager, $s.package, $s.version, $s.kind,
        $s.n_refs, $s.confidence, $s.file, $s.line
    }
    limit 1000000
}

// Stage-2 join primitives: exact descriptor match (env/svc), and the key_norm
// match (http/pkg). pkg canonical descriptors are always "." (SYMBOL_FORMAT.md
// — package identity lives in the manager/package fields, not the
// descriptor), so symbols_by_descriptor cannot distinguish packages;
// key_norm carries the package name for both exported and external rows
// instead. http also joins on key_norm rather than descriptor because the
// descriptor embeds the method, which consumers usually can't determine
// statically ("*").

query symbols_by_descriptor($scheme: String, $descriptor: String) {
    match {
        $s: RepoSymbol { scheme: $scheme, descriptor: $descriptor }
    }
    return {
        $s.slug, $s.repo, $s.role, $s.symbol, $s.scheme, $s.descriptor,
        $s.key_norm, $s.manager, $s.package, $s.version, $s.kind,
        $s.n_refs, $s.confidence, $s.file, $s.line
    }
    order { $s.repo asc }
    limit 1000
}

query symbols_by_key($scheme: String, $key_norm: String) {
    match {
        $s: RepoSymbol { scheme: $scheme, key_norm: $key_norm }
    }
    return {
        $s.slug, $s.repo, $s.role, $s.symbol, $s.scheme, $s.descriptor,
        $s.key_norm, $s.manager, $s.package, $s.version, $s.kind,
        $s.n_refs, $s.confidence, $s.file, $s.line
    }
    order { $s.repo asc }
    limit 1000
}

// ── Package maps ──────────────────────────────────────────────────
// Every repo's declared/fallback package identity (docs/PACKAGE_MAP.md).
// Read at bridge-write time to qualify symbols and feed the
// known_provider_package heuristic.

query all_package_maps() {
    match {
        $p: PackageMap
    }
    return {
        $p.repo, $p.name, $p.manager, $p.version, $p.provides, $p.declared
    }
    limit 10000
}

// ── Grouping reads ────────────────────────────────────────────────
// All bindings for a contract key (the workhorse behind providers / consumers /
// impact grouping).

query bindings_by_key($kind: String, $key_norm: String) {
    match {
        $b: InterfaceBinding { kind: $kind, key_norm: $key_norm }
    }
    return {
        $b.slug, $b.kind, $b.key, $b.key_norm, $b.role, $b.repo,
        $b.file, $b.symbol_id, $b.line, $b.language, $b.framework, $b.generic,
        $b.symbol, $b.confidence
    }
    order { $b.repo asc }
    limit 500
}

// Same filtered to one role — backs code_interface_providers / _consumers.

query bindings_by_key_role($kind: String, $key_norm: String, $role: String) {
    match {
        $b: InterfaceBinding { kind: $kind, key_norm: $key_norm, role: $role }
    }
    return {
        $b.slug, $b.kind, $b.key, $b.key_norm, $b.role, $b.repo,
        $b.file, $b.symbol_id, $b.line, $b.language, $b.framework, $b.generic,
        $b.symbol, $b.confidence
    }
    order { $b.repo asc }
    limit 500
}

// Same, in one repo — the `in_repo` narrowing of code_interface_providers /
// _consumers. Filtered in the match rather than after the read, so the limit
// below applies to that repo's rows: a key bound in more than 500 places
// across every repo would otherwise cut off the repo being asked about.

query bindings_by_key_role_repo($kind: String, $key_norm: String, $role: String, $repo: String) {
    match {
        $b: InterfaceBinding { kind: $kind, key_norm: $key_norm, role: $role, repo: $repo }
    }
    return {
        $b.slug, $b.kind, $b.key, $b.key_norm, $b.role, $b.repo,
        $b.file, $b.symbol_id, $b.line, $b.language, $b.framework, $b.generic,
        $b.symbol, $b.confidence
    }
    order { $b.file asc }
    limit 500
}

// Bindings attributed to a symbol — first half of code_cross_repo_impact.

query bindings_for_symbol($symbol_id: String) {
    match {
        $b: InterfaceBinding { symbol_id: $symbol_id }
    }
    return {
        $b.slug, $b.kind, $b.key, $b.key_norm, $b.role, $b.repo,
        $b.file, $b.symbol_id, $b.generic
    }
    limit 500
}

// Bindings in one source file — code_interface_bindings_in_file, which the
// language server reads to find the contract under the cursor.

query bindings_in_file($repo: String, $file: String) {
    match {
        $b: InterfaceBinding { repo: $repo, file: $file }
    }
    return {
        $b.kind, $b.key, $b.key_norm, $b.role, $b.line, $b.symbol_id,
        $b.framework, $b.generic
    }
    order { $b.line asc }
    limit 500
}

// ── Full-text search (BM25 on key_norm) ───────────────────────────

query search_bindings($query: String) {
    match {
        $b: InterfaceBinding
        search($b.key_norm, $query)
    }
    return {
        $b.slug, $b.kind, $b.key, $b.key_norm, $b.role, $b.repo,
        $b.file, $b.symbol_id, $b.framework, $b.generic
    }
    order { bm25($b.key_norm, $query) desc }
    limit 100
}

query search_bindings_by_kind($query: String, $kind: String) {
    match {
        $b: InterfaceBinding { kind: $kind }
        search($b.key_norm, $query)
    }
    return {
        $b.slug, $b.kind, $b.key, $b.key_norm, $b.role, $b.repo,
        $b.file, $b.symbol_id, $b.framework, $b.generic
    }
    order { bm25($b.key_norm, $query) desc }
    limit 100
}

// ── Cross-repo symbol uses (ExternalUse) ──────────────────────────
// One row per use of a name imported from another repo's package namespace
// (bridge-schema.pg, ExternalUse). Kept apart from InterfaceBinding so the
// package-consumer counts above never see them.

// One use. A batch writer can instead `load --mode merge` the same records,
// as write_bindings does for bindings.

query insert_external_use(
    $slug: String,
    $repo: String,
    $file: String,
    $line: I32,
    $symbol_id: String?,
    $target: String,
    $language: String,
    $indexed_at: DateTime
) {
    insert ExternalUse {
        slug: $slug, repo: $repo, file: $file, line: $line,
        symbol_id: $symbol_id, target: $target, language: $language,
        indexed_at: $indexed_at
    }
}

// Per-file purge, the same shape and for the same reason as
// delete_bindings_in_file: a reindex replaces only the files it re-parsed.

query delete_external_uses_in_file($repo: String, $file: String) {
    delete ExternalUse where repo = $repo and file = $file
}

// Every use of any name in `$targets`, across all repos. A reader passes each
// dotted name a definition can be imported as (its module path, and its parent
// package's when that package re-exports it), so one read covers both. The
// limit is a ceiling, not a page: the reader caps what it shows. A result of
// exactly 10000 rows may have been cut, and a cut drops the alphabetically
// last repos.

query external_uses_by_targets($targets: [String]) {
    match {
        $u: ExternalUse
        $u.target in $targets
    }
    return {
        $u.slug, $u.repo, $u.file, $u.line, $u.symbol_id, $u.target,
        $u.language
    }
    order { $u.repo asc, $u.file asc, $u.line asc }
    limit 10000
}
