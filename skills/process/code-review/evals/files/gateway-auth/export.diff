@@ -1,7 +1,26 @@
+import base64
+import json
+from datetime import timedelta
+
 from django.http import JsonResponse
+from django.utils import timezone

 from reports.models import EnrollmentReport


 def health(request):
     return JsonResponse({"status": "ok"})
+
+
+def _userinfo(request):
+    return json.loads(base64.b64decode(request.headers["X-Userinfo"]))
+
+
+def export_enrollments(request):
+    user = _userinfo(request)
+    days = request.GET.get("days", 7)
+    since = timezone.now() - timedelta(days=days)
+    rows = EnrollmentReport.objects.filter(
+        org_id=user["org_id"], created_on__gte=since
+    ).values("course_id", "enrolled", "completed")
+    return JsonResponse({"rows": list(rows)})
