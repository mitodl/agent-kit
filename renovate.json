{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["local>mitodl/.github:renovate-config"],
	"customManagers": [
		{
			"customType": "regex",
			"description": "omnigraph binary version pinned in witan-core's shared installer; both servers fetch this pinned release at runtime (no build-time bundling)",
			"managerFilePatterns": [
				"/^packages/witan-core/witan_core/omnigraph_install\\.py$/"
			],
			"matchStrings": ["_OMNIGRAPH_VERSION = \"(?<currentValue>[^\"]+)\""],
			"datasourceTemplate": "github-releases",
			"depNameTemplate": "ModernRelay/omnigraph"
		}
	]
}
