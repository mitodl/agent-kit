# Build-context excludes for the witan / omnigraph-server images
# (docker/witan.Dockerfile, docker/omnigraph-server.Dockerfile — both built
# from the repo root so they can reach the whole uv workspace).
.git
.github
.claude
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/node_modules
# Built by the ui-builder stage inside the image. Excluding the host's copy
# stops a stale local build being copied in by `COPY mcp/servers/witan/` and
# then only partially overlaid: COPY never deletes, so orphaned hashed assets
# from an older build would ride along.
mcp/servers/witan/witan/ui_dist
**/__cluster
**/*.omni
dist
build
*.egg-info
